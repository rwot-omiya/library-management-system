{
  "info": {
    "name": "Library Management System API",
    "_postman_id": "f9e7d8b7-1f5b-4c76-9d42-library-api",
    "description": "Requests for the Book, Genre, Auth, and User endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "genreId", "value": "1" },
    { "key": "bookId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register patron",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alex Reader\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"strong-password\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"strong-password\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        { "name": "Create genre", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Biography\",\n  \"description\": \"Life stories\"\n}" }, "url": "{{baseUrl}}/genres" } },
        { "name": "List genres", "request": { "method": "GET", "url": "{{baseUrl}}/genres" } },
        { "name": "Get genre", "request": { "method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}" } },
        { "name": "Update genre", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}" }, "url": "{{baseUrl}}/genres/{{genreId}}" } },
        { "name": "Delete genre", "request": { "method": "DELETE", "url": "{{baseUrl}}/genres/{{genreId}}" } }
      ]
    },
    {
      "name": "Books",
      "item": [
        { "name": "Create book (librarian)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Architecture\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780134494166\",\n  \"totalCopies\": 3,\n  \"genreId\": 1\n}" }, "url": "{{baseUrl}}/books" } },
        { "name": "List books with filters", "request": { "method": "GET", "url": "{{baseUrl}}/books?genreId=1&search=great&page=1&limit=10" } },
        { "name": "Get book", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" } },
        { "name": "Update book (librarian)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 5\n}" }, "url": "{{baseUrl}}/books/{{bookId}}" } },
        { "name": "Delete book (librarian)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/books/{{bookId}}" } }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get authenticated profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/users/profile" } }
      ]
    }
  ]
}
